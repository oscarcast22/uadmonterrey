---
import { Image } from "astro:assets";
import edificioUad from "../assets/images/main-page/edificio-uad.jpg";

interface Stat {
  value: number;
  prefix?: string;
  suffix?: string;
  label: string;
  duration?: number;
}

interface Props {
  title?: string;
  paragraphs?: string[];
  stats?: Stat[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title = "Nuestra Universidad",
  paragraphs = [
    "¡Te damos la bienvenida a la Comunidad Lobos!",
    'En la UD campus Monterrey, transformamos tu potencial en liderazgo. Somos una institución de excelencia académica firmemente respaldada por valores, donde cada cátedra está diseñada para impulsarte al éxito profesional y al desarrollo de tu sociedad.',
    "¿Por qué elegir el Proyecto Lobos?",
    "Presencia Nacional: El éxito de nuestro modelo educativo nos respalda en 28 campus en todo el país.",
    "Formación con Propósito: Creamos líderes comprometidos, innovadores y listos para transformar su entorno.",
    "Excelencia en Monterrey: Un espacio diseñado para dar el máximo de tus esfuerzos.",
  ],
  stats = [
    { value: 28, prefix: "+ ", label: "CAMPUS", duration: 1.5 },
    { value: 10, prefix: "+ ", label: "ESCUELAS DE MEDICINA", duration: 2 },
    { value: 30, prefix: "+ ", suffix: "k", label: "EGRESADOS", duration: 2.5 },
  ],
  image = edificioUad,
  imageAlt = "Edificio UAD Monterrey",
} = Astro.props;
---

<section class="university">
  <div class="container">
    <div class="university__grid">
      <div class="university__text">
        <h2 class="university__title">{title}</h2>
        {paragraphs.map((p) => <p class="university__paragraph">{p}</p>)}
        <div class="university__stats">
          {
            stats.map((stat) => (
              <div class="university__stat">
                <span
                  class="university__stat-value"
                  data-target={stat.value}
                  data-prefix={stat.prefix ?? ""}
                  data-suffix={stat.suffix ?? ""}
                  data-duration={stat.duration ?? 2}
                >
                  0
                </span>
                <span class="university__stat-label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div class="university__image-wrapper">
        <Image
          src={image}
          alt={imageAlt}
          width={600}
          densities={[1, 2]}
          class="university__image"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .university {
    padding: 5rem 0;
    background: var(--color-white);
  }

  .university__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .university__title {
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-gray-800);
    margin-bottom: 1.5rem;
    position: relative;
    opacity: 0;
  }

  .university__title::after {
    content: "";
    display: block;
    width: 130px;
    height: 3px;
    background: var(--color-black);
    margin-top: 0.5rem;
    border-radius: 2px;
  }

  .university__paragraph {
    font-size: 0.95rem;
    line-height: 1.2;
    color: var(--color-gray-800);
    margin-bottom: 1rem;
  }

  .university__stats {
    display: flex;
    gap: 2.5rem;
    margin-top: 2rem;
  }

  .university__stat {
    display: flex;
    flex-direction: column;
  }

  .university__stat-value {
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--color-gray-800);
    line-height: 1.2;
    opacity: 0;
  }

  .university__stat-label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-gray-800);
    letter-spacing: 0.05em;
  }

  .university__image-wrapper {
    position: relative;
  }

  .university__image {
    width: 85%;
    height: auto;
    justify-self: flex-end;
    border-radius: 4px;
    box-shadow: 0 8px 30px var(--color-shadow);
    display: block;
    opacity: 0;
  }

  @media (max-width: 900px) {
    .university {
      padding: 3.5rem 0;
    }

    .university__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .university__image-wrapper {
      order: -1;
    }

    .university__title {
      font-size: 1.75rem;
    }

    .university__paragraph {
      font-size: 0.88rem;
    }

    .university__stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      text-align: center;
    }

    .university__stat-value {
      font-size: 1.3rem;
    }

    .university__stat-label {
      font-size: 0.7rem;
      letter-spacing: 0.03em;
      line-height: 1.3;
    }

    .university__image {
      justify-self: center;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .university__stats {
      gap: 0.5rem;
    }

    .university__stat-value {
      font-size: 1.5rem;
    }

    .university__stat-label {
      font-size: 0.8rem;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector(".university");
  if (section) {
    gsap.fromTo(".university__title",
      { y: 25 },
      {
        y: 0,
        opacity: 1,
        duration: 0.7,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".university__title",
          start: "top 85%",
          once: true,
        },
      }
    );

    gsap.fromTo(".university__image",
      { scale: 1.03 },
      {
        scale: 1,
        opacity: 1,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".university__image-wrapper",
          start: "top 75%",
          once: true,
        },
      }
    );
  }

  const values = document.querySelectorAll<HTMLElement>(".university__stat-value");

  values.forEach((el, i) => {
    const target = parseInt(el.dataset.target ?? "0", 10);
    const prefix = el.dataset.prefix ?? "";
    const suffix = el.dataset.suffix ?? "";
    const duration = parseFloat(el.dataset.duration ?? "2");
    const obj = { value: 0 };
    const delay = i * 0.4;

    gsap.to(obj, {
      value: target,
      duration,
      delay,
      ease: "power2.out",
      scrollTrigger: {
        trigger: el.closest(".university__stats"),
        start: "top 80%",
        once: true,
      },
      onUpdate: () => {
        el.textContent = prefix + Math.round(obj.value) + suffix;
      },
    });

    gsap.to(el, {
      opacity: 1,
      duration: 0.6,
      delay,
      ease: "power2.out",
      scrollTrigger: {
        trigger: el.closest(".university__stats"),
        start: "top 80%",
        once: true,
      },
    });
  });
</script>
