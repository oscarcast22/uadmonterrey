---
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  title?: string;
  description?: string;
}

const {
  image,
  title = 'Laboratorios de Especialidad',
  description = 'Espacios diseñados para la experimentación y el prototipado digital. Aquí, el error es parte del aprendizaje antes de llegar al paciente.',
} = Astro.props;
---

<section class="labs">
  <div class="labs__container">
    <div class="labs__image-wrapper">
      <Image
        src={image}
        alt={title}
        width={800}
        height={500}
        densities={[1, 2]}
        class="labs__image"
        loading="lazy"
      />
    </div>
    <div class="labs__content">
      <h2 class="labs__title">{title}</h2>
      <p class="labs__description">{description}</p>
    </div>
  </div>
</section>

<style>
  .labs {
    padding: 6rem 2rem;
    background: var(--color-white);
  }

  .labs__container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .labs__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    opacity: 0;
  }

  .labs__title {
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    font-weight: 600;
    color: var(--color-dark);
    line-height: 1.2;
  }

  .labs__description {
    font-size: 0.95rem;
    color: var(--color-dark);
    line-height: 1.4;
  }

  .labs__image-wrapper {
    overflow: hidden;
    opacity: 0;
  }

  .labs__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .labs__container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .labs__content {
      text-align: center;
    }
  }

  @media (max-width: 768px) {
    .labs {
      padding: 2.5rem 1.5rem;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const imageWrapper = document.querySelector<HTMLElement>(".labs__image-wrapper");
  const content = document.querySelector<HTMLElement>(".labs__content");

  if (imageWrapper && content) {
    gsap.set(imageWrapper, { scale: 1.05 });
    gsap.set(content, { x: 30 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: ".labs",
        start: "top 75%",
        once: true,
      },
    });

    tl.to(imageWrapper, {
      opacity: 1,
      scale: 1,
      duration: 0.8,
      ease: "power3.out",
    }).to(
      content,
      {
        opacity: 1,
        x: 0,
        duration: 0.7,
        ease: "power3.out",
      },
      "-=0.5"
    );
  }
</script>
