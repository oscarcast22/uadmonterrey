---
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  title?: string;
  description?: string;
}

const {
  image,
  title = 'Laboratorios de Especialidad',
  description = 'Espacios diseñados para la experimentación y el prototipado digital. Aquí, el error es parte del aprendizaje antes de llegar al paciente.',
} = Astro.props;
---

<section class="labs">
  <div class="labs__container">
    <div class="labs__image-wrapper">
      <Image
        src={image}
        alt={title}
        width={800}
        height={500}
        densities={[1, 2]}
        class="labs__image"
        loading="lazy"
      />
    </div>
    <div class="labs__content">
      <h2 class="labs__title">{title}</h2>
      <p class="labs__description">{description}</p>
    </div>
  </div>
</section>

<style>
  .labs {
    padding: 6rem 2rem;
    background: var(--color-white);
  }

  .labs__container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .labs__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .labs__title {
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    font-weight: 600;
    color: var(--color-dark);
    line-height: 1.2;
  }

  .labs__description {
    font-size: 0.95rem;
    color: var(--color-dark);
    line-height: 1.4;
  }

  .labs__image-wrapper {
    overflow: hidden;
  }

  .labs__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .labs__container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .labs__content {
      text-align: center;
    }
  }

  @media (max-width: 768px) {
    .labs {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
