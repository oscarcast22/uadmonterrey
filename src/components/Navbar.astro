<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.25rem 2rem;
  }

  .navbar__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .navbar__logo svg {
    display: block;
    height: 32px;
    width: auto;
  }

  .navbar__logo-icon {
    fill: var(--color-hero-btn);
  }

  .navbar__logo-text path {
    fill: var(--color-text);
  }

  .navbar__logo {
    display: inline-flex;
    align-items: center;
    background: var(--color-white);
    border-radius: 50px;
    padding: 0.5rem 1.25rem;
    box-shadow: 0 2px 12px var(--color-shadow);
    transition: transform 0.2s ease;
  }

  .navbar__logo:hover {
    transform: scale(1.03);
  }

  .navbar.dark .navbar__logo {
    background: color-mix(in srgb, var(--color-white) 10%, transparent);
    backdrop-filter: blur(8px);
  }
</style>
