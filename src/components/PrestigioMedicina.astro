    color: var(--color-white);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }

  .prestigio__icon-label {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1;
  }

  .prestigio__content {
    flex: 1;
  }

  .prestigio__title {
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: var(--color-dark);
  }

  .prestigio__text {
    color: var(--color-dark);
    line-height: 1.3;
    font-size: 0.95rem;
    font-weight: 450;
  }

  @media (max-width: 768px) {
