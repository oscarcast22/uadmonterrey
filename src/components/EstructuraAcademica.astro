---
import { semestresMedicina } from '../data/planMedicina';
---

<section class="estructura" id="plan">
  <div class="container">
    <h2 class="estructura__title">Estructura Académica</h2>

    <div class="accordion">
      <button class="accordion__header" aria-expanded="false">
        <span>Plan de Estudios</span>
        <svg class="accordion__icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      
      <div class="accordion-animation-wrapper">
        <div class="accordion__body-item">
          <div class="accordion__content">
            <div class="plan-grid">
              {semestresMedicina.map((semestre) => (
                <div class="semestre">
                  <h3 class="semestre__title">{semestre.nombre}</h3>
                  <ul class="semestre__list">
                    {semestre.materias.map((materia) => (
                      <li class="semestre__materia">{materia}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

            <h3 class="accordion__subtitle">Ciclos Clínicos e Internado</h3>
            <p class="accordion__text">A partir del quinto semestre, el aprendizaje se traslada a los centros hospitalarios que forman parte de nuestra red.</p>
            <a href="/planes-de-estudio/PLAN_MEDICINA.jpg" class="accordion__btn" download>Descargar Plan de Estudios</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.querySelector('.accordion__header');
    const accordion = document.querySelector('.accordion');

    header?.addEventListener('click', () => {
      const isOpen = accordion?.classList.toggle('is-open');
      header.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  });
</script>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const title = document.querySelector<HTMLElement>(".estructura__title");
  const header = document.querySelector<HTMLElement>(".accordion__header");

  if (title && header) {
    gsap.set([title, header], { y: 20 });

    gsap.to(title, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".estructura",
        start: "top 80%",
        once: true,
      },
    });

    gsap.to(header, {
      opacity: 1,
      y: 0,
      duration: 0.5,
      ease: "power3.out",
      delay: 0.15,
      scrollTrigger: {
        trigger: ".estructura",
        start: "top 80%",
        once: true,
      },
    });
  }
</script>

<style>
  .estructura {
    padding: 6rem 2rem 8rem;
    background: var(--color-gray-100);
  }

  .estructura__title {
    font-size: clamp(2.8rem, 2.5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    margin-bottom: 4rem;
    color: var(--color-dark);
    opacity: 0;
  }

  .plan-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 2rem;
    margin-bottom: 2rem;
  }

  .semestre {
    padding: 0 0 1rem 0;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .semestre__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.6rem;
  }

  .semestre__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .semestre__materia {
    font-size: 0.85rem;
    color: var(--color-gray-600);
    line-height: 1.5;
  }

  .accordion {
    border-radius: 6px;
  }

  .accordion__header {
    width: 100%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 4rem;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 1.5rem;
    font-weight: 500;
    cursor: pointer;
    border-radius: 2px;
    transition: background 0.2s ease;
    opacity: 0;
  }

  .accordion__header:hover {
    background: color-mix(in srgb, var(--color-primary) 90%, black);
  }

  .accordion__icon {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .accordion.is-open .accordion__icon {
    transform: rotate(180deg);
  }

  .accordion-animation-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease-out;
  }

  .accordion.is-open .accordion-animation-wrapper {
    grid-template-rows: 1fr;
  }

  .accordion__body-item {
    min-height: 0;
    overflow: hidden;
  }

  .accordion__content {
    padding: 1.5rem;
    text-align: left;
    border: 2px dotted var(--color-gray-200);
    border-radius: 2px;
    margin-top: 20px;
  }

  .accordion__subtitle {
    font-size: 1.3rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
    color: var(--color-dark);
    text-align: center;
  }

  .accordion__text {
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .accordion__btn {
    display: block;
    width: fit-content;
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .accordion__btn:hover {
    background: color-mix(in srgb, var(--color-primary) 85%, black);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .plan-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .estructura {
      padding: 3rem 1.5rem;
    }

    .plan-grid {
      grid-template-columns: 1fr;
    }

    .accordion__header {
      padding: 0.7rem 1.5rem;
      font-size: 1.2rem;
    }
  }
</style>
