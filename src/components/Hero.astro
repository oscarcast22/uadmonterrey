        ></path>
        <g class="hero__logo-text">
          <path d="M204.46,104.32V11.16h28.96v94.55c0,8.72,5.53,11.86,14.74,11.86s14.75-3.14,14.75-11.86V11.16h27.91v93.15c0,19.54-14.74,30.7-43.18,30.7s-43.18-11.16-43.18-30.7Z"></path>
          <path d="M299.46,11.16h44.24c28.96,0,43.18,10.8,43.18,30.62v62.66c0,19.83-14.22,30.62-43.18,30.62h-44.24V11.16ZM343.17,117.37c9.22,0,14.75-3.19,14.75-12.04V40.9c0-8.85-5.53-12.04-14.75-12.04h-14.74v88.51h14.74Z"></path>
        </g>
        <g class="hero__logo-subtitle">
          <path d="M228.22,150.89v24.36h-3.06v-19.81l-8.01,10.51-8.02-10.51v19.81h-3.06v-24.36h3.27l7.82,10.24,7.8-10.24h3.27Z"></path>
          <path d="M252.5,154.24c2.45,2.46,3.68,5.39,3.68,8.79s-1.23,6.36-3.68,8.81c-2.46,2.46-5.46,3.68-9,3.68s-6.53-1.23-8.98-3.68c-2.46-2.45-3.68-5.39-3.68-8.81s1.23-6.33,3.68-8.79c2.45-2.46,5.45-3.69,8.98-3.69s6.54,1.23,9,3.69ZM243.51,153.22c-2.6,0-4.84.95-6.74,2.85-1.9,1.9-2.84,4.22-2.84,6.95s.95,5.08,2.84,6.98c1.9,1.9,4.14,2.84,6.74,2.84s4.86-.95,6.76-2.84c1.9-1.9,2.84-4.22,2.84-6.98s-.95-5.05-2.84-6.95-4.15-2.85-6.76-2.85Z"></path>
          <path d="M262.11,150.89l13.88,19.47v-19.47h3.06v24.36h-3.39l-13.53-18.98v18.98h-3.06v-24.36h3.03Z"></path>
          <path d="M290.32,153.55v21.7h-3.05v-21.7h-5.82v-2.66h14.68v2.66h-5.81Z"></path>
          <path d="M311.82,150.89v2.66h-10.19v8.19h10.19v2.66h-10.19v8.19h10.19v2.66h-13.26v-24.36h13.26Z"></path>
          <path d="M321.53,167.28h-2.86v7.97h-3.06v-24.36h6.98c2.03.27,3.73,1.09,5.1,2.47,1.59,1.59,2.39,3.49,2.39,5.71s-.82,4.15-2.45,5.79c-1.08,1.09-2.04,1.74-2.88,1.95l5.47,8.45h-3.54l-5.13-7.97ZM318.67,153.56v11.04h3.01c1.42,0,2.66-.53,3.72-1.58,1.06-1.06,1.59-2.37,1.59-3.95s-.53-2.88-1.59-3.93-2.3-1.57-3.72-1.57h-3.01Z"></path>
          <path d="M339.16,167.28h-2.86v7.97h-3.06v-24.36h6.98c2.03.27,3.73,1.09,5.1,2.47,1.59,1.59,2.39,3.49,2.39,5.71s-.82,4.15-2.45,5.79c-1.08,1.09-2.04,1.74-2.88,1.95l5.47,8.45h-3.54l-5.13-7.97ZM336.3,153.56v11.04h3.01c1.42,0,2.66-.53,3.72-1.58,1.06-1.06,1.59-2.37,1.59-3.95s-.53-2.88-1.59-3.93-2.3-1.57-3.72-1.57h-3.01Z"></path>
          <path d="M364.11,150.89v2.66h-10.19v8.19h10.19v2.66h-10.19v8.19h10.19v2.66h-13.26v-24.36h13.26Z"></path>
          <path d="M374.91,165.4l-8.36-14.51h3.39l6.52,11.28,6.5-11.28h3.39l-8.36,14.51v9.85h-3.06v-9.85Z"></path>
        </g>
      </svg>
    </div>
    <h1 class="hero__title" style={`--title-max-width: ${titleMaxWidth};`}>{title}</h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {
      links.length > 0 && (
        <div class="hero__links">
          {links.map((link) => (
            <a
              href={link.href}
              class:list={[
                "hero__link",
                link.variant === "secondary"
                  ? "hero__link--secondary"
                  : link.variant === "whatsapp"
                    ? "hero__link--whatsapp"
                    : "hero__link--primary",
              ]}
              target={link.variant === "whatsapp" ? "_blank" : undefined}
            >
              {link.text}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    max-height: var(--hero-height, min(100vh, 800px));
    z-index: 0;
    overflow: hidden;
    background: var(--color-gray-900);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.5) 40%,
      rgba(0, 0, 0, 0.45) 100%
    );
  }

  .hero__branding {
    position: absolute;
    top: 1.5rem;
    left: 2rem;
    z-index: 1;
    background: var(--color-white);
    border-radius: 50px;
    padding: 0.5rem 1.6rem;
    box-shadow: 0 2px 12px var(--color-shadow);
    transform: translateY(-8px);
    will-change: opacity, transform;
  }

  .hero__branding svg {
    display: block;
    height: 40px;
    width: auto;
  }

  .hero__logo-icon {
    fill: var(--color-primary);
  }

  .hero__logo-text path {
    fill: var(--color-gray-800);
  }

  .hero__logo-subtitle path {
    fill: var(--color-primary);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .hero__title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 600;
    color: var(--color-white);
    line-height: 1.15;
    max-width: var(--title-max-width, 700px);
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 20px var(--color-shadow);
    opacity: 0;
    transform: translateY(15px);
    will-change: opacity, transform;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1rem);
    color: color-mix(in srgb, var(--color-white) 90%, transparent);
    max-width: 800px;
    line-height: 1.6;
    margin-bottom: 2rem;
    opacity: 0;
    transform: translateY(10px);
    will-change: opacity, transform;
  }

  .hero__links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__link {
    display: inline-block;
    padding: 0.15rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: background-color 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    text-align: center;
    border: 2px solid transparent;
    opacity: 0;
    transform: translateY(8px);
    will-change: opacity, transform;
  }

  .hero__link--primary {
    background: var(--color-hero-btn);
    color: var(--color-white);
    border-color: var(--color-hero-btn);
  }

  .hero__link--primary:hover {
    background: color-mix(in srgb, var(--color-hero-btn) 80%, black);
    border-color: color-mix(in srgb, var(--color-hero-btn) 80%, black);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px var(--color-shadow);
  }

  .hero__link--secondary {
    background: var(--color-white);
    color: var(--color-hero-btn);
    border-color: var(--color-white);
  }

  .hero__link--secondary:hover {
    background: var(--color-gray-100);
    color: color-mix(in srgb, var(--color-hero-btn) 80%, black);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px var(--color-shadow);
  }

  .hero__link--whatsapp {
    background: color-mix(in srgb, var(--color-white) 90%, transparent);
    color: var(--color-hero-btn);
    border-color: var(--color-white);
  }

  .hero__link--whatsapp:hover {
    background: var(--color-white);
    color: color-mix(in srgb, var(--color-hero-btn) 80%, black);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px var(--color-shadow);
  }

  @media (max-width: 768px) {
    .hero {
      max-height: var(--hero-height-mobile, min(100vh, 600px));
    }

    .hero__branding {
      top: 1.25rem;
      left: 1.25rem;
      padding: 0.35rem 1.25rem;
    }

    .hero__branding svg {
      height: 30px;
    }

    .hero__content {
      align-items: center;
      text-align: center;
    }

    .hero__title {
      max-width: 100%;
    }

    .hero__subtitle {
      max-width: 100%;
    }

    .hero__links {
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
    }

    .hero__link {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .hero__title {
      font-size: 1.85rem;
    }


    .hero__link {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 370px) {
    .hero__title {
      font-size: 1.65rem;
    }

    .hero__subtitle {
      font-size: 0.82rem;
    }
  }
</style>

<script>
  import gsap from "gsap";

  function initHeroAnimation() {
    const title = document.querySelector(".hero__title");
    const subtitle = document.querySelector(".hero__subtitle");
    const links = document.querySelectorAll(".hero__link");

    if (!title) return;

    const tl = gsap.timeline({ defaults: { ease: "power2.out" } });

    tl.to(
      title,
      {
        opacity: 1,
        y: 0,
        duration: 0.5,
      },
      "-=0.2"
    );

    if (subtitle) {
      tl.to(
        subtitle,
        {
          opacity: 1,
          y: 0,
          duration: 0.4,
        },
        "-=0.2"
      );
    }

    if (links.length > 0) {
      tl.to(
        links,
        {
          opacity: 1,
          y: 0,
          duration: 0.4,
          stagger: 0.1,
        },
        "-=0.2"
      );
    }
  }

  document.addEventListener("astro:page-load", initHeroAnimation);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroAnimation);
  } else {
    initHeroAnimation();
  }
</script>
