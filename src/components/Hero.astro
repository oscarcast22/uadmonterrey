---
import { Image } from "astro:assets";

interface HeroLink {
  text: string;
  href: string;
  variant?: "primary" | "secondary";
}

interface Props {
  backgroundImage?: ImageMetadata;
  title: string;
  subtitle?: string;
  links?: HeroLink[];
}

const { backgroundImage, title, subtitle, links = [] } = Astro.props;
---

<section class="hero">
  {
    backgroundImage && (
      <div class="hero__bg">
        <Image
          src={backgroundImage}
          alt=""
          width={1920}
          height={800}
          densities={[1, 2]}
          class="hero__image"
          loading="eager"
        />
      </div>
    )
  }
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <div class="hero__branding">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 164 43"
        width="120"
        height="32"
        class="hero__logo"
      >
