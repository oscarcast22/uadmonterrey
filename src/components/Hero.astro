---
import { Image } from "astro:assets";

interface HeroLink {
  text: string;
  href: string;
  variant?: "primary" | "secondary" | "whatsapp";
}

interface Props {
  backgroundImage?: ImageMetadata;
  title: string;
  subtitle?: string;
  links?: HeroLink[];
  titleMaxWidth?: string;
}

const {
  backgroundImage,
  title,
  subtitle,
  links = [],
  titleMaxWidth = '700px',
} = Astro.props;
---

<section class="hero">
  {
    backgroundImage && (
      <div class="hero__bg">
        <Image
          src={backgroundImage}
          alt="Campus universitario UD Monterrey"
          width={1920}
          height={800}
          densities={[1, 2]}
          class="hero__image"
          loading="eager"
        />
      </div>
    )
  }
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <div class="hero__branding">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 388 188"
        class="hero__logo"
      >
        <path
          class="hero__logo-icon"
