          </a>
        ))
      }
    </div>
    <div class="footer__bottom">
      <p>Visítanos en Calle Padre Mier y Cuauhtémoc</p>
      <div class="footer__legal">
        <a href="/aviso-de-privacidad" class="footer__privacy">Aviso de Privacidad</a>
        <span class="footer__separator">|</span>
        <a href="/terminos-de-servicio" class="footer__privacy">Términos de Servicio</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 0;
    background: var(--color-gray-900);
    color: var(--color-white);
    padding: 3rem 2rem 2rem;
  }

  .footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .footer__brand svg {
    display: block;
  }

  .footer__logo-icon {
    fill: var(--color-white);
  }

  .footer__logo-text path {
    fill: var(--color-white);
  }

  .footer__social {
    display: flex;
    gap: 3rem;
  }

  .footer__social-link {
    color: var(--color-white);
    opacity: 0.87;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    display: flex;
  }

  .footer__social-link:hover {
    opacity: 1;
  }

  .footer__bottom {
    text-align: center;
    font-size: 0.82rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    opacity: 0.87;
  }

  .footer__legal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer__separator {
    opacity: 0.5;
  }

  .footer__privacy {
    color: var(--color-white);
    text-decoration: underline;
    transition: opacity 0.2s ease;
    opacity: 0.8;
  }

  .footer__privacy:hover {
    opacity: 1;
  }
</style>
