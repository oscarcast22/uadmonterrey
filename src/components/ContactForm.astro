---
interface Props {
  email?: string;
  phone?: string;
  address?: string;
  description?: string;
}

const {
  email = 'contacto@uadlobos.mx',
  phone = '81 1919 5252',
  address = 'Calle Padre Mier y Cuauhtémoc',
  description = 'Resuelve todas tus dudas. Un asesor de admisiones se pondrá en contacto contigo a la brevedad.',
} = Astro.props;
---

<section class="contact" id="contacto">
  <div class="contact__card">
    <div class="contact__info">
      <h2 class="contact__title">Contáctanos</h2>
      <p class="contact__description">{description}</p>
      <div class="contact__details">
        <div class="contact__detail">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span>{email}</span>
        </div>
        <div class="contact__detail">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>{phone}</span>
        </div>
        <div class="contact__detail">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Visítanos en {address}</span>
        </div>
      </div>
    </div>
    <div class="contact__form-wrapper">
      <form class="contact__form" action="#" method="POST">
        <input type="text" name="nombre" placeholder="Nombre Completo" required />
        <input type="email" name="email" placeholder="Correo Electrónico" required />
        <input type="tel" name="telefono" placeholder="Teléfono" />
        <input type="text" name="programa" placeholder="Programa de Interés" />
        <textarea name="mensaje" placeholder="Mensaje (opcional)" rows="3"></textarea>
        <button type="submit" class="contact__submit">Enviar Información</button>
        <p class="contact__privacy">Al enviar, aceptas nuestro aviso de privacidad y términos de servicio.</p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 5rem 2rem;
  }

  .contact__card {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    background: var(--color-white);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 8px 40px var(--color-shadow);
  }

  .contact__info {
    background: var(--color-primary);
    color: var(--color-white);
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .contact__title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .contact__description {
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.9;
    margin-bottom: 2.5rem;
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact__detail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  .contact__detail svg {
    flex-shrink: 0;
    opacity: 0.8;
  }

  .contact__form-wrapper {
    padding: 3rem 2.5rem;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact__form input,
  .contact__form textarea {
    width: 100%;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--color-gray-200);
    border-radius: 10px;
    font-size: 0.95rem;
    font-family: inherit;
    background: var(--color-gray-100);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
  }

  .contact__form input:focus,
  .contact__form textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .contact__form textarea {
    resize: vertical;
    min-height: 80px;
  }

  .contact__submit {
    align-self: flex-start;
    padding: 0.85rem 2rem;
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.25s ease;
  }

  .contact__submit:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--color-shadow);
  }

  .contact__privacy {
    font-size: 0.78rem;
    color: var(--color-gray-400);
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) {
    .contact__card {
      grid-template-columns: 1fr;
    }

    .contact__info {
      padding: 2rem 1.5rem;
    }

    .contact__form-wrapper {
      padding: 2rem 1.5rem;
    }
  }
</style>
