---
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  title?: string;
  description?: string;
}

const {
  image,
  title = 'Clínica Odontológica',
  description = 'Nuestra clínica es el corazón de tu formación. Desde el cuarto semestre, integrarás equipos de trabajo en un entorno real, atendiendo pacientes de la comunidad con estándares internacionales de bioseguridad y tecnología de punta.',
} = Astro.props;
---

<section class="clinic">
  <div class="clinic__container">
    <div class="clinic__content">
      <h2 class="clinic__title">{title}</h2>
      <p class="clinic__description">{description}</p>
    </div>
    <div class="clinic__image-wrapper">
      <Image
        src={image}
        alt={title}
        width={800}
        height={500}
        densities={[1, 2]}
        class="clinic__image"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .clinic {
    padding: 6rem 2rem;
    background: var(--color-white);
  }

  .clinic__container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: center;
  }

  .clinic__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .clinic__title {
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    font-weight: 600;
    color: var(--color-dark);
    line-height: 1.2;
  }

  .clinic__description {
    font-size: 0.95rem;
    color: var(--color-dark);
    line-height: 1.4;
  }

  .clinic__image-wrapper {
    overflow: hidden;
  }

  .clinic__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .clinic__container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .clinic__content {
      order: 2;
      text-align: center;
    }

    .clinic__image-wrapper {
      order: 1;
    }
  }

  @media (max-width: 768px) {
    .clinic {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
