---
import { Image } from 'astro:assets';

interface Props {
  backgroundImage: ImageMetadata;
  title: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  overlayOpacity?: number;
  overlayColor?: string;
  buttonTextColor?: string;
}

const {
  backgroundImage,
  title,
  subtitle,
  buttonText = 'Hablar con un Asesor',
  buttonHref = '#contacto',
  overlayOpacity = 0.5,
  overlayColor = '0, 0, 0',
  buttonTextColor = 'var(--color-gray-800)',
} = Astro.props;
---

<section class="cta-banner">
  <div class="cta-banner__bg">
    <Image
      src={backgroundImage}
      alt=""
      width={1920}
      height={800}
      densities={[1, 2]}
      class="cta-banner__image"
      loading="lazy"
    />
  </div>
  <div class="cta-banner__overlay" style={`--cta-overlay: ${overlayOpacity}; --cta-color: ${overlayColor};`}></div>
  <div class="cta-banner__content" style={`--cta-btn-text-color: ${buttonTextColor};`}>
    <h2 class="cta-banner__title">{title}</h2>
    {subtitle && <p class="cta-banner__subtitle">{subtitle}</p>}
    <a href={buttonHref} class="cta-banner__btn">{buttonText}</a>
  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    width: 100%;
    padding: 6rem 2rem;
    overflow: hidden;
  }

  .cta-banner__bg {
    position: absolute;
    inset: 0;
  }

  .cta-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cta-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(var(--cta-color), var(--cta-overlay));
  }

  .cta-banner__content {
    position: relative;
    z-index: 1;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cta-banner__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 650;
    color: var(--color-white);
    line-height: 1.2;
  }

  .cta-banner__subtitle {
    font-size: 1.05rem;
    color: color-mix(in srgb, var(--color-white) 85%, transparent);
    line-height: 1.6;
  }

  .cta-banner__btn {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.85rem 2rem;
    background: var(--color-white);
    color: var(--cta-btn-text-color);
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.25s ease;
  }

  .cta-banner__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px var(--color-shadow);
  }
</style>
