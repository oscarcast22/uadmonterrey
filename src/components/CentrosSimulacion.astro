---
import { Image } from 'astro:assets';
import labMecanoterapia from '../assets/images/escuela_de_medicina/lab-mecanoterapia.jpg';
import anatomage from '../assets/images/escuela_de_medicina/anatomage.jpg';
import camaraGessel from '../assets/images/escuela_de_medicina/camara-gessel.jpg';

interface Centro {
  nombre: string;
  imagen: ImageMetadata;
}

const centros: Centro[] = [
  { nombre: 'Lab. Mecanoterapia', imagen: labMecanoterapia },
  { nombre: 'Anatomage', imagen: anatomage },
  { nombre: 'Camara Gessel', imagen: camaraGessel },
];
---

<section class="simulacion">
  <div class="simulacion__container">
    <h2 class="simulacion__title">Centros de Simulación</h2>
    <p class="simulacion__subtitle">
      Contamos con laboratorios de simulación de alta fidelidad, donde nuestros estudiantes practican escenarios
      clínicos críticos en un entorno seguro y controlado, reduciendo la brecha entre la teoría y la práctica real.
    </p>
    <div class="simulacion__grid">
      {centros.map((centro) => (
        <div class="simulacion__card">
          <div class="simulacion__image-wrapper">
            <Image
              src={centro.imagen}
              alt={centro.nombre}
              width={400}
              height={300}
              densities={[1, 2]}
              class="simulacion__image"
              loading="lazy"
            />
            <div class="simulacion__overlay"></div>
            <h3 class="simulacion__card-title">{centro.nombre}</h3>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .simulacion {
    background: var(--color-gray-100);
    padding: 6rem 2rem;
  }

  .simulacion__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .simulacion__title {
    text-align: center;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--color-salud);
    margin-bottom: 1rem;
    opacity: 0;
  }

  .simulacion__subtitle {
    text-align: center;
    font-size: 0.95rem;
    color: var(--color-gray-800);
    max-width: 900px;
    font-weight: 500;
    margin: 0 auto 3rem;
    line-height: 1.2;
    opacity: 0;
  }

  .simulacion__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.5rem;
  }

  .simulacion__card {
    border-radius: 20px;
    overflow: hidden;
    opacity: 0;
  }

  .simulacion__image-wrapper {
    position: relative;
    aspect-ratio: 4 / 4;
    overflow: hidden;
    border-radius: 20px;
  }

  .simulacion__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.8;
  }

  .simulacion__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(60, 180, 229, 0.8) 0%,
      rgba(60, 180, 229, 0.3) 40%,
      transparent 65%
    );
  }

  .simulacion__card-title {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-white);
    text-align: center;
    z-index: 1;
  }

  @media (max-width: 900px) {
    .simulacion {
      padding: 4rem 1.5rem;
    }

    .simulacion__grid {
      gap: 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .simulacion {
      padding: 3rem 1rem;
    }

    .simulacion__subtitle {
      font-size: 0.9rem;
      margin-bottom: 2rem;
    }

    .simulacion__grid {
      grid-template-columns: 1fr;
      max-width: 500px;
      margin: 0 auto;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const title = document.querySelector<HTMLElement>(".simulacion__title");
  const subtitle = document.querySelector<HTMLElement>(".simulacion__subtitle");
  const cards = document.querySelectorAll<HTMLElement>(".simulacion__card");

  if (title && subtitle && cards.length > 0) {
    gsap.set(title, { y: 20 });
    gsap.set(subtitle, { y: 15 });
    gsap.set(cards, { scale: 1.04 });

    gsap.to(title, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: "power3.out",
      scrollTrigger: {
        trigger: title,
        start: "top 88%",
        once: true,
      },
    });

    gsap.to(subtitle, {
      opacity: 1,
      y: 0,
      duration: 0.5,
      ease: "power3.out",
      scrollTrigger: {
        trigger: subtitle,
        start: "top 88%",
        once: true,
      },
    });

    cards.forEach((card, i) => {
      gsap.to(card, {
        opacity: 1,
        scale: 1,
        duration: 0.6,
        ease: "power3.out",
        delay: i * 0.15,
        scrollTrigger: {
          trigger: card,
          start: "top 70%",
          once: true,
        },
      });
    });
  }
</script>
