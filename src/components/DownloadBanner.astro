---
interface Props {
  title?: string;
  subtitle?: string;
  downloadUrl?: string;
  backgroundColor?: string;
}

const {
  title = 'Plan de Estudios',
  subtitle = 'Un camino estructurado desde las ciencias básicas hasta la especialización clínica.',
  downloadUrl = '#',
  backgroundColor = 'var(--color-primary)',
} = Astro.props;
---

<section class="download-banner" style={`--banner-bg: ${backgroundColor};`}>
  <div class="download-banner__container">
    <h2 class="download-banner__title">{title}</h2>
    <p class="download-banner__subtitle">{subtitle}</p>
    <a href={downloadUrl} class="download-banner__btn" download>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .download-banner {
    background: var(--banner-bg);
    padding: 2rem;
    text-align: center;
  }

  .download-banner__container {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .download-banner__title {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 600;
    color: var(--color-white);
    line-height: 1.2;
    opacity: 0;
  }

  .download-banner__subtitle {
    font-size: 1.1rem;
    color: var(--color-white);
    line-height: 1.4;
    opacity: 0;
  }

  .download-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--color-white);
    border-radius: 50%;
    transition: all 0.25s ease;
    text-decoration: none;
    opacity: 0;
  }

  .download-banner__btn:hover {
    color: #e9e9e9;
    scale: 1.1;
  }

  .download-banner__btn svg {
    width: 40px;
    height: 40px;
  }

  @media (max-width: 768px) {
    .download-banner {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const title = document.querySelector<HTMLElement>(".download-banner__title");
  const subtitle = document.querySelector<HTMLElement>(".download-banner__subtitle");
  const btn = document.querySelector<HTMLElement>(".download-banner__btn");

  if (title && subtitle && btn) {
    gsap.set([title, subtitle, btn], { y: 15 });
    gsap.set(btn, { scale: 0.8 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: ".download-banner",
        start: "top 85%",
        once: true,
      },
    });

    tl.to(title, {
      opacity: 1,
      y: 0,
      duration: 0.5,
      ease: "power3.out",
    })
      .to(
        subtitle,
        {
          opacity: 1,
          y: 0,
          duration: 0.4,
          ease: "power3.out",
        },
        "-=0.3"
      )
      .to(
        btn,
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.5,
          ease: "back.out(1.7)",
        },
        "-=0.2"
      );
  }
</script>
