---
import "../styles/global.css";
import "@fontsource-variable/montserrat/index.css";

interface Props {
  title: string;
  description?: string;
  primaryColor?: string;
  heroBtnColor?: string;
  heroHeight?: string;
  heroHeightMobile?: string;
  ogImage?: string;
}

const {
  title,
  description = "Universidad de Durango - Campus Monterrey",
  primaryColor = "#c10230",
  heroBtnColor = "#c1272d",
  heroHeight = "min(100vh, 800px)",
  heroHeightMobile = "min(100vh, 600px)",
  ogImage = "/og-default.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteOGImage = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html
  lang="es"
  style={`--color-primary: ${primaryColor}; --color-hero-btn: ${heroBtnColor}; --hero-height: ${heroHeight}; --hero-height-mobile: ${heroHeightMobile};`}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={primaryColor} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang="es-MX" href={canonicalURL.href} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL.href} />

    <link rel="preconnect" href="https://rsms.me/" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="UD Monterrey" />
    <meta property="og:image" content={absoluteOGImage} />
    <meta property="og:locale" content="es_MX" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOGImage} />

    <title>{title}</title>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://monterrey.uadlobos.mx/#website",
            "url": "https://monterrey.uadlobos.mx",
            "name": "UD Monterrey",
            "description": "Universidad de Durango Campus Monterrey - Excelencia académica en medicina, odontología y ciencias de la salud.",
            "publisher": {
              "@id": "https://monterrey.uadlobos.mx/#organization"
            }
          },
          {
            "@type": "EducationalOrganization",
            "@id": "https://monterrey.uadlobos.mx/#organization",
            "name": "Universidad de Durango - Campus Monterrey",
            "alternateName": "UD Monterrey",
            "url": "https://monterrey.uadlobos.mx",
            "logo": {
              "@type": "ImageObject",
              "url": "https://monterrey.uadlobos.mx/favicon.svg",
              "width": 512,
              "height": 512
            },
            "description": "Universidad de educación superior en Monterrey. Ofrece licenciaturas en medicina, odontología y ciencias de la salud.",
            "address": {
