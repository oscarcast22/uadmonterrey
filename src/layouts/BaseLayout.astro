                    "name": "Ingeniería Biomédica"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "EducationalOccupationalProgram",
                    "name": "Ingeniería en Inteligencia Artificial y Seguridad de Software"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "EducationalOccupationalProgram",
                    "name": "Ingeniería en Seguridad Industrial y Laboral"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "EducationalOccupationalProgram",
                    "name": "Ingeniería Industrial"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "EducationalOccupationalProgram",
                    "name": "Licenciatura en Administración de Negocios"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "EducationalOccupationalProgram",
                    "name": "Licenciatura en Cosmetología"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "EducationalOccupationalProgram",
                    "name": "Licenciatura en Criminología"
                  }
                }
              ]
            }
          }
        ]
      }
    </script>

    <!-- Meta Pixel Code -->
    <script>
      // @ts-nocheck
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js",
      );
      fbq("init", "1333737615376159");
      fbq("track", "PageView");
    </script>
    <!-- End Meta Pixel Code -->
  </head>
  <body>
    <!-- Meta Pixel Code (noscript) -->
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=1333737615376159&ev=PageView&noscript=1"
      />
    </noscript>
    <!-- End Meta Pixel Code -->
    <slot />
  </body>
</html>
