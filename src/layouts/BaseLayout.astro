                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "EducationalOccupationalProgram",
                    "name": "Licenciatura en Medicina"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "EducationalOccupationalProgram",
                    "name": "Licenciatura en Nutrición"
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "EducationalOccupationalProgram",
                    "name": "Licenciatura en Odontología"
                  }
                },
                {
