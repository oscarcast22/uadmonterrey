              "https://wa.me/8119195252"
            ],
            "hasOfferCatalog": {
              "@type": "OfferCatalog",
              "name": "Programas Educativos",
              "itemListElement": [
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "EducationalOccupationalProgram",
