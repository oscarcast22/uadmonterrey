---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  pageTitle: string;
  pageDescription: string;
  otherPage: { href: string; label: string };
}

const { title, pageTitle, pageDescription, otherPage } = Astro.props;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <header class="legal-hero">
    <div class="legal-hero__inner">
      <button class="legal-hero__back" onclick="history.back()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        Volver
      </button>
      <h1 class="legal-hero__title">{title}</h1>
    </div>
  </header>

  <main class="legal-page">
    <div class="legal-page__container">
      <slot />

      <nav class="legal-nav">
        <div class="legal-nav__row">
          <a href="/" class="legal-nav__link">← Ir al inicio</a>
          <a href={otherPage.href} class="legal-nav__link">{otherPage.label} →</a>
        </div>
        <div class="legal-nav__row legal-nav__row--secondary">
          <span class="legal-nav__label">Otras páginas:</span>
          <a href="/odontologia" class="legal-nav__link">Odontología</a>
          <a href="/medicina" class="legal-nav__link">Medicina</a>
          <a href="/escuela-de-medicina" class="legal-nav__link">Escuela de Medicina</a>
        </div>
      </nav>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .legal-hero {
    background: var(--color-gray-900);
    padding: 4.5rem 2rem 2rem;
    text-align: center;
  }

  .legal-hero__inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  .legal-hero__back {
    position: absolute;
    top: -2rem;
    left: calc(50% - 400px);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-white);
    color: var(--color-gray-800);
    border: none;
    border-radius: 50px;
    padding: 0.5rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: var(--font-sans);
    cursor: pointer;
    box-shadow: 0 2px 12px var(--color-shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .legal-hero__back:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 18px var(--color-shadow);
  }

  .legal-hero__title {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: 0.5px;
  }

  .legal-page {
    background: var(--color-white);
    padding: 3rem 2rem 3rem;
  }

  .legal-page__container {
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.8;
    font-size: 1rem;
    color: var(--color-gray-800);
  }

  .legal-page__container :global(h2) {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    font-weight: 700;
    color: var(--color-gray-900);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .legal-page__container :global(p) {
    margin-bottom: 1rem;
  }

  .legal-page__container :global(ul) {
    margin: 1rem 0 1.5rem 1.5rem;
    list-style: disc;
  }

  .legal-page__container :global(li) {
    margin-bottom: 0.5rem;
  }

  .legal-nav {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-gray-200);
  }

  .legal-nav__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .legal-nav__row--secondary {
    margin-top: 1rem;
    justify-content: flex-start;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .legal-nav__label {
    font-size: 0.9rem;
    color: var(--color-gray-600);
    font-weight: 700;
  }

  .legal-nav__link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-gray-600);
    transition: color 0.2s ease;
  }

  .legal-nav__link:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .legal-hero {
      padding: 4rem 1.25rem 1.5rem;
    }

    .legal-hero__back {
      left: 0;
      top: -1.5rem;
    }

    .legal-page {
      padding: 2rem 1.25rem;
    }

    .legal-nav__row {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .legal-nav__row--secondary {
      justify-content: center;
    }
  }
</style>
