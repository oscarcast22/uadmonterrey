---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ClinicSection from '../components/ClinicSection.astro';
import DownloadBanner from '../components/DownloadBanner.astro';
import LabsSection from '../components/LabsSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import heroImage from '../assets/images/odontologia/hero_odontologia.jpg';
import clinicaImage from '../assets/images/odontologia/clinica-odontologica.jpg';
import labsImage from '../assets/images/odontologia/laboratorios-especialidad.jpg';
import bannerImage from '../assets/images/escuela_de_medicina/banner-cta.jpg';

const primaryColor = '#3cb4e5';
---

<BaseLayout
  title="Licenciatura en Odontología - UAD Monterrey"
  description="Estudia Odontología en UAD Monterrey. Clínica propia, laboratorios de especialidad y tecnología de punta. Inscripciones abiertas 2026."
  primaryColor={primaryColor}
  heroBtnColor={primaryColor}
  heroHeightMobile="min(100vh, 750px)"
>
  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "EducationalOccupationalProgram",
      "name": "Licenciatura en Odontología",
      "description": "Forma profesionales de la salud bucal con excelencia clínica, innovación y compromiso humano.",
      "url": "https://www.uadmonterrey.mx/odontologia",
      "provider": {
        "@type": "EducationalOrganization",
        "name": "Universidad Autónoma de Durango - Campus Monterrey"
      },
      "educationalLevel": "Licenciatura",
      "timeToComplete": "P5Y",
      "occupationalCategory": "Cirujano Dentista"
    }
  </script>

  <Hero
    backgroundImage={heroImage}
    title="Transforma vidas a través de la salud bucal, con excelencia clínica, innovación y compromiso humano."
    subtitle="Desarrolla los conocimientos científicos, habilidades clínicas y valores humanos necesarios para prevenir, diagnosticar y tratar enfermedades bucodentales, brindando atención integral con ética, responsabilidad y compromiso social."
    titleMaxWidth="none"
    links={[
      { text: 'Inscripciones Abiertas', href: '#contacto', variant: 'primary' },
    ]}
  />

  <div class="page-content">
    <ClinicSection
      image={clinicaImage}
      title="Clínica Odontológica"
      description="Nuestra clínica es el corazón de tu formación. Desde el cuarto semestre, integrarás equipos de trabajo en un entorno real, atendiendo pacientes de la comunidad con estándares internacionales de bioseguridad y tecnología de punta."
    />

    <DownloadBanner
      title="Plan de Estudios"
      subtitle="Un camino estructurado desde las ciencias básicas hasta la especialización clínica."
      downloadUrl="/planes-de-estudio/PLAN_ODONTOLOGIA.jpg"
      backgroundColor={primaryColor}
    />

    <LabsSection
      image={labsImage}
      title="Laboratorios de Especialidad"
      description="Espacios diseñados para la experimentación y el prototipado digital. Aquí, el error es parte del aprendizaje antes de llegar al paciente."
    />

    <CtaBanner
      backgroundImage={bannerImage}
      title="¿Listo para transformar la salud bucal?"
      subtitle="Las inscripciones para el próximo ciclo académico ya están abiertas. Forma parte de la excelencia académica de Universidad de Durango."
      buttonText="Hablar con un Asesor"
      buttonHref="#contacto"
      overlayColor="14, 165, 233"
      overlayOpacity={0.85}
      buttonTextColor={primaryColor}
    />

    <ContactForm
      email="admiciones@monterrey.uad.mx"
      phone="81 1919 5252"
      address="Calle Padre Mier y Cuauhtémoc"
      description="Resuelve todas tus dudas. Un asesor de admisiones se pondrá en contacto contigo a la brevedad."
      hideProgram={true}
      programValue="Odontología"
    />
  </div>

  <Footer />
</BaseLayout>
