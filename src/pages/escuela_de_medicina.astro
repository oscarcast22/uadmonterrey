---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LicenciaturasSalud from '../components/LicenciaturasSalud.astro';
import CentrosSimulacion from '../components/CentrosSimulacion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { areas } from '../data/ofertaEducativa';
import heroImage from '../assets/images/escuela_de_medicina/escuela_de_medicina_hero.jpg';
import bannerImage from '../assets/images/escuela_de_medicina/banner-cta.jpg';

const primaryColor = '#3cb4e5';
const saludAreas = areas.filter((a) => a.nombre === 'Salud');
---

<BaseLayout title="Escuela de Medicina - UAD Monterrey" primaryColor={primaryColor} heroBtnColor={primaryColor}>
  <Hero
    backgroundImage={heroImage}
    title="Liderando el futuro del cuidado humano"
    subtitle="Formamos profesionales de excelencia con un enfoque humanista, integrando la tecnología de vanguardia y la investigación traslacional para transformar el bienestar global."
    links={[
      { text: 'Postularme Ahora', href: '#contacto', variant: 'primary' },
    ]}
  />

  <div class="page-content">
    <LicenciaturasSalud />

    <CentrosSimulacion />

    <CtaBanner
      backgroundImage={bannerImage}
      title="Comienza tu carrera en la salud"
      subtitle="Únete a una comunidad de aprendizaje dedicada a salvar vidas y mejorar la salud colectiva. Inscripciones abiertas para el ciclo 2026."
      buttonText="Hablar con un Asesor"
      buttonHref="#contacto"
      overlayColor="60, 180, 229"
      overlayOpacity={0.85}
      buttonTextColor={primaryColor}
    />

    <ContactForm
      email="admiciones@monterrey.uad.mx"
      phone="81 1919 5252"
      address="Calle Padre Mier y Cuauhtémoc"
      description="Resuelve todas tus dudas. Un asesor de admisiones se pondrá en contacto contigo a la brevedad."
      areas={saludAreas}
    />
  </div>

  <Footer />
</BaseLayout>
