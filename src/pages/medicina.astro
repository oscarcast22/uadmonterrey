---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

const primaryColor = '#0ea5e9';
---

<BaseLayout title="Medicina - UAD Monterrey" primaryColor={primaryColor}>
  <Hero
    title="Medicina: Ciencia al servicio de la vida"
    subtitle="Formamos líderes médicos con rigor científico, compasión humana y la capacidad técnica para transformar la salud global en el siglo XXI."
    links={[
      { text: 'Iniciar Proceso de Admisión', href: '#contacto', variant: 'primary' },
      { text: 'Explorar Plan de Estudios', href: '#plan', variant: 'secondary' },
    ]}
  />

  <div class="page-content">
    <section class="placeholder-section">
      <div class="container">
        <h2>Contenido en desarrollo</h2>
        <p>Esta página está en construcción. Pronto encontrarás información completa sobre la Licenciatura en Medicina.</p>
      </div>
    </section>
  </div>

  <Footer />
</BaseLayout>

<style>
  .placeholder-section {
    padding: 5rem 0;
    text-align: center;
  }

  .placeholder-section h2 {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .placeholder-section p {
    color: var(--color-gray-600);
    max-width: 500px;
    margin: 0 auto;
  }
</style>
