---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EstructuraAcademica from '../components/EstructuraAcademica.astro';
import PrestigioMedicina from '../components/PrestigioMedicina.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { areas } from '../data/ofertaEducativa';
import heroImage from '../assets/images/medicina/medicina_hero.jpg';
import bannerImage from '../assets/images/escuela_de_medicina/banner-cta.jpg';

const primaryColor = '#3cb4e5';
const saludAreas = areas.filter((a) => a.nombre === 'Salud');
---

<BaseLayout
  title="Licenciatura en Medicina - UAD Monterrey"
  description="Estudia Medicina en UAD Monterrey. Formamos líderes médicos con rigor científico y compasión humana. Admisión selectiva 2026. Campus de vanguardia."
  primaryColor={primaryColor}
  heroBtnColor={primaryColor}
>
  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "EducationalOccupationalProgram",
      "name": "Licenciatura en Medicina",
      "description": "Formamos líderes médicos con rigor científico, compasión humana y la capacidad técnica para transformar la salud global.",
      "url": "https://www.uadmonterrey.mx/medicina",
      "provider": {
        "@type": "EducationalOrganization",
        "name": "Universidad Autónoma de Durango - Campus Monterrey"
      },
      "educationalLevel": "Licenciatura",
      "timeToComplete": "P6Y",
      "occupationalCategory": "Médico Cirujano"
    }
  </script>

  <Hero
    backgroundImage={heroImage}
    title="Medicina: Ciencia al servicio de la vida"
    subtitle="Formamos líderes médicos con rigor científico, compasión humana y la capacidad técnica para transformar la salud global en el siglo XXI."
    links={[
      { text: 'Iniciar Proceso de Admisión', href: '#contacto', variant: 'primary' },
    ]}
  />

  <div class="page-content">
    <EstructuraAcademica />

    <PrestigioMedicina />

    <CtaBanner
      backgroundImage={bannerImage}
      title="Comienza tu Trayectoria Médica"
      subtitle="El proceso de admisión es altamente selectivo. Asegura tu lugar en la próxima generación de médicos de élite."
      buttonText="Hablar con un Asesor"
      buttonHref="#contacto"
      overlayColor="60, 180, 229"
      overlayOpacity={0.85}
      buttonTextColor={primaryColor}
    />

    <ContactForm
      email="admiciones@monterrey.uad.mx"
      phone="81 1919 5252"
      address="Calle Padre Mier y Cuauhtémoc"
      description="Resuelve todas tus dudas. Un asesor de admisiones se pondrá en contacto contigo a la brevedad."
      areas={saludAreas}
      hideProgram={true}
      programValue="Medicina"
    />
  </div>

  <Footer />
</BaseLayout>
