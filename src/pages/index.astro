---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NuestraUniversidad from '../components/NuestraUniversidad.astro';
import OfertaEducativa from '../components/OfertaEducativa.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import heroImage from '../assets/images/main-page/main-hero.jpg';
import bannerImage from '../assets/images/main-page/baner.jpg';
---

<BaseLayout title="UAD Monterrey - Universidad de Durango">
  <Hero
    backgroundImage={heroImage}
    title="Forja tu futuro con excelencia académica"
    links={[
      { text: 'Inscripciones Abiertas', href: '#contacto', variant: 'primary' },
      { text: 'Explora Carreras', href: '#carreras', variant: 'secondary' },
    ]}
  />

  <div class="page-content">
    <NuestraUniversidad />

    <OfertaEducativa />

    <CtaBanner
      backgroundImage={bannerImage}
      title="Tu excelencia empieza aquí."
      subtitle="Únete a la próxima generación de líderes y descubre por qué somos la elección número uno para los estudiantes más ambiciosos del país."
      buttonText="Hablar con un Asesor"
      buttonHref="#contacto"
    />

    <ContactForm />
  </div>

  <Footer />
</BaseLayout>



