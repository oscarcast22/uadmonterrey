---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NuestraUniversidad from '../components/NuestraUniversidad.astro';
import OfertaEducativa from '../components/OfertaEducativa.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import heroImage from '../assets/images/main-page/main-hero.jpg';
import bannerImage from '../assets/images/main-page/baner.jpg';
---

<BaseLayout
  title="UD Monterrey - Universidad de Durango"
  description="Universidad de Durango Campus Monterrey. Excelencia académica en medicina, odontología y ciencias de la salud. Inscripciones abiertas 2026."
>
  <Hero
    backgroundImage={heroImage}
    title="Forja tu futuro con excelencia académica"
    links={[
      { text: 'Inscripciones Abiertas', href: '#contacto', variant: 'primary' },
      { text: 'Explora Carreras', href: '#oferta-educativa', variant: 'secondary' },
      { text: 'Hablar con un asesor', href: 'https://wa.me/8119195252?text=Me%20interesa%20recibir%20más%20información%20de%20las%20licenciaturas', variant: 'whatsapp' },
    ]}
  />

  <div class="page-content">
    <NuestraUniversidad />

    <OfertaEducativa />

    <CtaBanner
      backgroundImage={bannerImage}
      title="¿Listo para dar el siguiente paso? "
      subtitle=" ¡Únete a la manada y sé parte del Proyecto Lobos!"
      buttonText="Hablar con un Asesor"
    />

    <ContactForm successColor="#16a34a" />
  </div>

  <Footer />
</BaseLayout>



