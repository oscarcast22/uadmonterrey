---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LicenciaturasSalud from '../components/LicenciaturasSalud.astro';
import CentrosSimulacion from '../components/CentrosSimulacion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { areas } from '../data/ofertaEducativa';
import heroImage from '../assets/images/escuela_de_medicina/escuela_de_medicina_hero.jpg';
import bannerImage from '../assets/images/escuela_de_medicina/banner-cta.jpg';

const primaryColor = '#3cb4e5';
const saludAreas = areas.filter((a) => a.nombre === 'Salud');
---

<BaseLayout
  title="UD Monterrey - Escuela de Medicina"
  description="Escuela de Medicina UD Monterrey. Licenciaturas en salud con enfoque humanista, tecnología de vanguardia e investigación traslacional. Postúlate ahora."
  primaryColor={primaryColor}
  heroBtnColor={primaryColor}
>
  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ItemList",
          "name": "Licenciaturas en Ciencias de la Salud",
          "description": "Programas de formación profesional en salud con enfoque humanista y tecnología de vanguardia.",
          "url": "https://monterrey.uadlobos.mx/escuela-de-medicina",
          "about": {
            "@id": "https://monterrey.uadlobos.mx/#organization"
          },
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "item": {
                "@type": "EducationalOccupationalProgram",
                "@id": "https://monterrey.uadlobos.mx/#programa-medicina",
                "name": "Medicina",
                "educationalLevel": "Licenciatura",
                "url": "https://monterrey.uadlobos.mx/medicina",
                "provider": { "@id": "https://monterrey.uadlobos.mx/#organization" }
              }
            },
            {
              "@type": "ListItem",
              "position": 2,
              "item": {
                "@type": "EducationalOccupationalProgram",
                "@id": "https://monterrey.uadlobos.mx/#programa-odontologia",
                "name": "Odontología",
                "educationalLevel": "Licenciatura",
                "url": "https://monterrey.uadlobos.mx/odontologia",
                "provider": { "@id": "https://monterrey.uadlobos.mx/#organization" }
              }
            },
            {
              "@type": "ListItem",
              "position": 3,
              "item": {
                "@type": "EducationalOccupationalProgram",
                "@id": "https://monterrey.uadlobos.mx/#programa-enfermeria",
                "name": "Enfermería",
                "educationalLevel": "Licenciatura",
                "provider": { "@id": "https://monterrey.uadlobos.mx/#organization" }
              }
            },
            {
              "@type": "ListItem",
              "position": 4,
              "item": {
                "@type": "EducationalOccupationalProgram",
                "@id": "https://monterrey.uadlobos.mx/#programa-nutricion",
                "name": "Nutrición",
                "educationalLevel": "Licenciatura",
                "provider": { "@id": "https://monterrey.uadlobos.mx/#organization" }
              }
            },
            {
              "@type": "ListItem",
              "position": 5,
              "item": {
                "@type": "EducationalOccupationalProgram",
                "@id": "https://monterrey.uadlobos.mx/#programa-fisioterapia",
                "name": "Fisioterapia",
                "educationalLevel": "Licenciatura",
                "provider": { "@id": "https://monterrey.uadlobos.mx/#organization" }
              }
            },
            {
              "@type": "ListItem",
              "position": 6,
              "item": {
                "@type": "EducationalOccupationalProgram",
                "@id": "https://monterrey.uadlobos.mx/#programa-psicologia",
                "name": "Psicología",
                "educationalLevel": "Licenciatura",
                "provider": { "@id": "https://monterrey.uadlobos.mx/#organization" }
              }
            }
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Inicio",
              "item": "https://monterrey.uadlobos.mx/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Escuela de Medicina",
              "item": "https://monterrey.uadlobos.mx/escuela-de-medicina"
            }
          ]
        }
      ]
    }
  </script>

  <Hero
    backgroundImage={heroImage}
    title="Liderando el futuro del cuidado humano"
    subtitle="Formamos profesionales de excelencia con un enfoque humanista, integrando la tecnología de vanguardia y la investigación traslacional para transformar el bienestar global."
    links={[
      { text: 'Postularme Ahora', href: '#contacto', variant: 'primary' },
      { text: 'Hablar con un asesor', href: 'https://wa.me/8119195252?text=Me%20interesa%20recibir%20más%20información%20de%20las%20licenciaturas%20de%20la%20salud', variant: 'whatsapp' },
    ]}
  />

  <div class="page-content">
    <LicenciaturasSalud />

    <CentrosSimulacion />

    <CtaBanner
      backgroundImage={bannerImage}
      title="Comienza tu carrera en la salud"
      subtitle="Únete a una comunidad de aprendizaje dedicada a salvar vidas y mejorar la salud colectiva. Inscripciones abiertas para el ciclo 2026."
      buttonText="Hablar con un Asesor"
      overlayColor="60, 180, 229"
      overlayOpacity={0.85}
      buttonTextColor={primaryColor}
      buttonHref="https://wa.me/8119195252?text=Me%20interesa%20recibir%20más%20información%20de%20las%20licenciaturas%20de%20la%20salud"
    />

    <ContactForm
      areas={saludAreas}
    />
  </div>

  <Footer whatsappUrl="https://wa.me/8119195252?text=Me%20interesa%20recibir%20más%20información%20de%20las%20licenciaturas%20de%20la%20salud" />
</BaseLayout>
